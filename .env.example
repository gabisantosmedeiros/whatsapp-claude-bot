# ------------------------------------------------------------------
# Porta em que o servidor Express vai rodar localmente
# ------------------------------------------------------------------
PORT=3000

# ------------------------------------------------------------------
# WhatsApp Cloud API (Meta for Developers)
# ------------------------------------------------------------------
# Token de acesso (temporário de 24h para testes, ou permanente
# gerado via System User em produção)
WHATSAPP_TOKEN=

# ID do número de telefone (Phone Number ID), encontrado em
# "WhatsApp > Configuração da API" no painel do app da Meta
WHATSAPP_PHONE_NUMBER_ID=

# Token que você mesmo escolhe (qualquer string secreta). É usado
# para validar o webhook no passo de verificação da Meta.
WHATSAPP_VERIFY_TOKEN=

# ------------------------------------------------------------------
# Claude API (Anthropic)
# ------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Modelo do Claude a ser usado
CLAUDE_MODEL=claude-sonnet-5

# Instrução de sistema opcional (personalidade/persona do bot)
CLAUDE_SYSTEM_PROMPT="Você é o assistente virtual da Loja XYZ. Responda dúvidas sobre produtos, horário de funcionamento (seg-sex, 9h às 18h) e política de trocas (até 30 dias com nota fiscal). Seja breve e cordial. Se perguntarem algo que você não sabe, diga para falar com um atendente humano pelo número (84) 99999-9999."
